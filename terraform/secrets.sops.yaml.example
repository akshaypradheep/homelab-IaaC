# This is the PLAINTEXT shape of terraform/secrets.sops.yaml (gitignored,
# real file is SOPS/age-encrypted). Copy this file to secrets.sops.yaml,
# fill in real values, then run: sops -e -i terraform/secrets.sops.yaml
#
# scripts/decrypt-tf-secrets.sh turns this into a gitignored
# terraform.auto.tfvars.json that `terraform plan/apply` picks up
# automatically — the encrypted file itself is never read by Terraform.

proxmox_endpoint: "https://pve.homelab.lan:8006/"
proxmox_api_token: "terraform@pve!tf-token=00000000-0000-0000-0000-000000000000"
ssh_public_key: "ssh-ed25519 AAAA...your-public-key... ansible@homelab"
