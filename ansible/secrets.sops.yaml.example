# Plaintext shape of ansible/secrets.sops.yaml (gitignored; real file is
# SOPS/age-encrypted, same age key as terraform/secrets.sops.yaml).
#
# Unlike the Terraform secrets, this file is NEVER decrypted to disk —
# playbooks read individual keys straight out of the encrypted file via the
# community.sops lookup plugin, e.g.:
#   {{ lookup('community.sops', 'secrets.sops.yaml')['postgres_password'] }}

postgres_password: "changeme"
grafana_admin_password: "changeme"
