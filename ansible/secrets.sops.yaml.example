# Plaintext shape of ansible/secrets.sops.yaml (gitignored; real file is
# SOPS/age-encrypted, same age key as terraform/secrets.sops.yaml).
#
# Unlike the Terraform secrets, this file is NEVER decrypted to disk —
# playbooks read individual keys straight out of the encrypted file via the
# community.sops.sops lookup plugin (note the full 3-part FQCN —
# `community.sops` alone resolves to "lookup plugin not found"), parsed
# with `| from_yaml` since the lookup returns the raw decrypted file as a
# string, not a dict, e.g.:
#   {{ (lookup('community.sops.sops', playbook_dir + '/../secrets.sops.yaml') | from_yaml)['postgres_password'] }}

postgres_password: "changeme"
grafana_admin_password: "changeme"
