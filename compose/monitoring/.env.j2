{# Rendered by playbooks/deploy-compose.yml (only when a stack has an
   .env.j2) straight to {{ docker_compose_root }}/monitoring/.env, which
   docker compose reads automatically for ${VAR} substitution in
   docker-compose.yml. Never decrypted to disk on the controller — read
   live from ansible/secrets.sops.yaml via the community.sops.sops lookup.

   Two gotchas, verified live against this repo's ansible-core 2.21:
   - The plugin's FQCN is `community.sops.sops` (3 parts) — `community.sops`
     (2 parts) resolves to "lookup plugin not found", not an error that
     points at the real problem.
   - It returns the decrypted file as a raw string, not a parsed dict —
     `| from_yaml` is required before subscripting a key out of it. #}
GRAFANA_ADMIN_PASSWORD={{ (lookup('community.sops.sops', playbook_dir + '/../secrets.sops.yaml') | from_yaml)['grafana_admin_password'] }}
