# Terraform
# (.terraform.lock.hcl is intentionally NOT ignored — commit it)
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/servers.auto.tfvars
terraform/terraform.auto.tfvars.json
terraform/secrets.sops.yaml
!terraform/secrets.sops.yaml.example
!terraform/servers.auto.tfvars.example

# Generated hand-off artifacts — regenerated by `make tf-apply`
ansible/inventory/hosts.generated.yml
compose/monitoring/targets.generated.json

# scripts/apply.sh's saved plan — contains plaintext secrets even though
# the source variables are marked `sensitive`; deleted by the script's own
# cleanup trap, this is just a backstop
terraform/tfplan
terraform/tfplan.json

# Ansible secrets — real file is SOPS-encrypted, read live via lookup
ansible/secrets.sops.yaml
!ansible/secrets.sops.yaml.example

# age keys
keys/

# CI transient key material (written and deleted within a single workflow run)
.ci/

# misc
.DS_Store
*.retry
.idea/
